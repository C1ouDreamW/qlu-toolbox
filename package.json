{
  "name": "lumatile",
  "version": "2.0.4",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "author": "C1ouDreamW",
  "description": "一格有光：面向齐鲁工业大学学生的非官方本地校园效率工具",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test tests/release.test.mjs tests/desktop-manifest.test.mjs tests/release-pipeline.test.mjs tests/rehearsal.test.mjs tests/android-signing.test.mjs tests/channels.test.mjs",
    "predev": "node scripts/prepare-release.mjs --platform host",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:mobile": "vitest run --config apps/mobile/vitest.config.ts",
    "test:desktop": "npm run build:electron && node --test tests/desktop.test.mjs tests/updates.test.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:backend": "uv run --locked pyinstaller --noconfirm --distpath backend-dist --workpath backend-build LumaTileWorker.spec",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "dist": "node scripts/prepare-release.mjs --platform windows && npm run build:backend && npm run build && electron-builder --win dir --x64",
    "dist:zip": "node scripts/prepare-release.mjs --platform windows && npm run build:backend && npm run build && electron-builder --win zip --x64",
    "dist:installer": "node scripts/prepare-release.mjs --platform windows && npm run build:backend && npm run build && electron-builder --win nsis --x64",
    "dist:mac": "node scripts/prepare-release.mjs --platform macos && npm run build:backend && npm run build && electron-builder --mac dmg --arm64",
    "mobile:dev": "npm run dev --workspace @lumatile/mobile",
    "mobile:build": "npm run build --workspace @lumatile/mobile",
    "mobile:sync": "npm run cap:sync --workspace @lumatile/mobile"
  },
  "dependencies": {
    "@lumatile/academic-core": "0.1.0",
    "@lumatile/contracts": "0.1.0",
    "@lumatile/schedule-ui": "0.1.0",
    "@lumatile/update-notes": "0.1.0",
    "lucide-vue-next": "^0.525.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "js-yaml": "4.3.0",
    "vitest": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^3.0.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "student.qlu.toolbox",
    "productName": "LumaTile",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "config/release-migration.json",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/lumatile.ico",
      "target": ["nsis"],
      "artifactName": "LumaTile_v${version}_${arch}.${ext}",
      "extraResources": [
        {
          "from": "backend-dist/LumaTileWorker.exe",
          "to": "backend/LumaTileWorker.exe"
        }
      ]
    },
    "mac": {
      "icon": "assets/lumatile.icns",
      "category": "public.app-category.education",
      "identity": "-",
      "entitlements": "installer-assets/entitlements.mac.plist",
      "entitlementsInherit": "installer-assets/entitlements.mac.plist",
      "target": ["dmg"],
      "artifactName": "LumaTile_v${version}_${arch}.${ext}",
      "extraResources": [
        {
          "from": "backend-dist/LumaTileWorker",
          "to": "backend/LumaTileWorker"
        }
      ]
    },
    "dmg": {
      "title": "LumaTile ${version}",
      "artifactName": "LumaTile_v${version}_${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "LumaTile_v${version}_${arch}_Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LumaTile",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["zh_CN"],
      "displayLanguageSelector": false,
      "installerIcon": "assets/lumatile.ico",
      "uninstallerIcon": "assets/lumatile.ico",
      "installerHeader": "installer-assets/installerHeader.bmp",
      "installerSidebar": "installer-assets/installerSidebar.bmp",
      "uninstallerSidebar": "installer-assets/installerSidebar.bmp",
      "include": "installer-assets/installer.nsh"
    }
  }
}
