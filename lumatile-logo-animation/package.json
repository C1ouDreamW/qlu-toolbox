{
  "name": "lumatile-logo-animation",
  "version": "1.0.0",
  "description": "LumaTile Logo 启动动画，3 秒，1080x1080，30 FPS",
  "type": "module",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check": "npm run lint && node --experimental-strip-types scripts/check-animation.ts",
    "render:mp4": "remotion render LogoRevealWhite out/logo-reveal.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:webm": "remotion render LogoReveal out/logo-reveal-transparent.webm --codec=vp9 --pixel-format=yuva420p --image-format=png --crf=12",
    "render:mov": "remotion render LogoReveal out/logo-reveal-transparent.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png"
  }
}
